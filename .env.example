ANTHROPIC_API_KEY=sk-ant-...

# CRM (REST/JSON, OAuth 2.0)
CRM_BASE_URL=https://crm.example.com/api/v1
CRM_CLIENT_ID=your-client-id
CRM_CLIENT_SECRET=your-client-secret

# Document Management System (REST, API key)
DMS_BASE_URL=https://dms.example.com/api/v1
DMS_API_KEY=your-api-key

# Policy Admin System (SOAP — WSDL URL pending client discovery, see D5.U1)
SOAP_WSDL_URL=https://policy-admin.example.com/ws?wsdl

# Optional: Redis for CRM fallback persistence (see D5.A6)
REDIS_URL=redis://localhost:6379/0

# Set true to use mock clients (no real HTTP calls)
MOCK_MODE=true

LOG_LEVEL=INFO
